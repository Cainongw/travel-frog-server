{
  "name": "travel-frog-server",
  "version": "0.12.0",
  "private": true,
  "description": "Minimal local archive server for Travel Frog China",
  "scripts": {
    "start": "node server.js",
    "start:admin": "node start_admin.js",
    "test": "node --test tests/*_test.js",
    "admin:install": "npm --prefix admin-ui ci",
    "admin:dev": "npm --prefix admin-ui run dev",
    "admin:build": "npm --prefix admin-ui run build",
    "apk:prepare": "node tools/android/build_local_client.js",
    "apk:native": "node tools/android/build_native_login.js",
    "device:probe": "node tools/qa/device_probe.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "openid-client": "^6.9.0"
  }
}
